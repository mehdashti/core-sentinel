#: src/lib/labels.js:53
#, javascript-format
msgid "Fan stalled: %s"
msgstr "فن گیر کرده: %s"

#: src/lib/labels.js:54
#, javascript-format
msgid "Driven at %s but reporting 0 RPM. Check the fan and its cable."
msgstr ""
"با %s توان راه‌اندازی شده ولی دور صفر گزارش می‌دهد. فن و کابلش را بررسی کنید."

#: src/lib/labels.js:59
#, javascript-format
msgid "Fan stopped: %s"
msgstr "فن ایستاده: %s"

#: src/lib/labels.js:60
msgid "It was spinning before and now reports 0 RPM."
msgstr "قبلاً می‌چرخید و حالا دور صفر گزارش می‌دهد."

#: src/lib/labels.js:64
#, javascript-format
msgid "Fan too slow: %s"
msgstr "فن بیش از حد کند است: %s"

#: src/lib/labels.js:65
#, javascript-format
msgid "%s, below the %s minimum you set."
msgstr "%s، کمتر از حداقل %s که تنظیم کرده‌اید."

#: src/lib/labels.js:70
#, javascript-format
msgid "Too hot: %s"
msgstr "بیش از حد داغ: %s"

#: src/lib/labels.js:71
#, javascript-format
msgid "%s, at or above the %s limit."
msgstr "%s، برابر یا بالاتر از حد %s."

#: src/lib/labels.js:76
#, javascript-format
msgid "Disk almost full: %s"
msgstr "دیسک تقریباً پر شده: %s"

#: src/lib/labels.js:77
#, javascript-format
msgid "Only %s free (%s)."
msgstr "فقط %s فضای آزاد (%s)."

#: src/lib/labels.js:81
msgid "Memory is running out"
msgstr "حافظه در حال تمام شدن است"

#: src/lib/labels.js:82
#, javascript-format
msgid "%s has been moved to swap on disk; expect slowdowns."
msgstr "%s به swap روی دیسک منتقل شده؛ منتظر کندی باشید."

#: src/lib/labels.js:86
msgid "The system is thrashing"
msgstr "سیستم درگیر کمبود شدید حافظه است"

#: src/lib/labels.js:87
#, javascript-format
msgid "All tasks were stalled on memory %s of the last 10 seconds."
msgstr "همهٔ کارها %s از ۱۰ ثانیهٔ اخیر منتظر حافظه ماندند."

#: src/lib/labels.js:92
msgid "The CPU is saturated"
msgstr "پردازنده اشباع شده است"

#: src/lib/labels.js:93
#, javascript-format
msgid "Tasks waited for a CPU %s of the last minute."
msgstr "کارها %s از دقیقهٔ اخیر منتظر CPU ماندند."

#: src/lib/labels.js:97
msgid "Disk I/O is the bottleneck"
msgstr "ورودی/خروجی دیسک گلوگاه شده است"

#: src/lib/labels.js:98
#, javascript-format
msgid "All tasks were stalled on I/O %s of the last 10 seconds."
msgstr "همهٔ کارها %s از ۱۰ ثانیهٔ اخیر منتظر ورودی/خروجی ماندند."

#: src/lib/labels.js:107
#, javascript-format
msgid "Back to normal: %s"
msgstr "به حالت عادی برگشت: %s"

#: src/ui/indicator.js:145
msgid "Per-core load"
msgstr "بار هر هسته"

#: src/ui/indicator.js:149
