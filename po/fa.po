msgstr "%d هسته، %d رشته"

#: src/ui/indicator.js:217
#, javascript-format
msgid "Tasks waiting for a CPU: %s (10 s), %s (1 min)"
msgstr "کارهای منتظر CPU: %s (۱۰ ثانیه)، %s (۱ دقیقه)"

#: src/ui/indicator.js:224
#, javascript-format
msgid "Core %d"
msgstr "هسته %d"

#: src/ui/indicator.js:234
#, javascript-format
